TOKEN = TOKEN_HERE
brand_name='ZyroX'
NEXT_PUBLIC_BRAND_NAME='ZyroX'

# ── Owner / Staff IDs (comma-separated Discord user IDs) ──────────────────────
# Edit this list — no code changes needed anywhere else
OWNER_IDS=YOUR_DISCORD_USER_ID

# Set to true to load Jishaku owner eval commands. Leave false unless you need them.
JISHAKU_ENABLED="false"

# ── Lavalink ──────────────────────────────────────────────────────────────────
# Leave host/password blank to disable music.
LAVALINK_HOST=""
LAVALINK_PASSWORD=""

# Set to true if the node uses HTTPS/WSS (secure), false for HTTP/WS
LAVALINK_SECURE="false"

# Only needed when LAVALINK_SECURE is false (e.g. 2333)
LAVALINK_PORT="2333"

# ── Optional external integrations ────────────────────────────────────────────
# Leave blank to disable only the related feature.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
PEXELS_API_KEY=""
GIPHY_API_KEY=""
MAPQUEST_API_KEY=""

# ── Emoji Sync ────────────────────────────────────────────────────────────────
# Set to true to enable automatic application emoji sync on startup
EMOJI_SYNC="false"

# ── API / Dashboard Backend ───────────────────────────────────────────────────
# Set to true to enable the dashboard API server (disabled by default in Phase 0)
API_ENABLED="false"
# Bind address — keep 127.0.0.1 unless you explicitly need a public bind
API_HOST="127.0.0.1"
# Required to bind on 0.0.0.0 or other non-loopback interfaces
API_ALLOW_PUBLIC_BIND="false"
# Port the API server listens on
API_PORT="8000"
# Legacy shared API key (Phase 1+ Dashboard uses session/JWT via Next.js proxy — not browser-exposed)
DASHBOARD_API_KEY=""

# ── Phase 1 platform (PostgreSQL + Dashboard V2 auth) ───────────────────────
POSTGRES_ENABLED="true"
DATABASE_URL="postgresql+asyncpg://cls:cls@localhost:5432/cls_discord"
ROOT_OWNER_ID=
OPS_GUILD_ID=
# Security alerts must be a channel inside OPS_GUILD_ID. There is no product-guild fallback.
OPS_SECURITY_ALERT_CHANNEL_ID=
INTERNAL_SERVICE_KEY=
INTERNAL_IDENTITY_SIGNING_KEY=
INTERNAL_IDENTITY_AUDIENCE="cls-fastapi"
INTERNAL_IDENTITY_TTL_SECONDS="60"
STORAGE_ROOT="storage"
BACKUP_STAGING_DIR="backups/staging"
# Extra CORS-allowed origins, comma-separated (optional)
CORS_ORIGINS=""

# ── CLS guild allowlist (comma-separated guild IDs) ─
ALLOWED_GUILD_IDS=
# Allow empty allowlist for local dev only (must be false in production)
ALLOW_EMPTY_GUILD_ALLOWLIST="false"

# ── Legacy verification (unsafe on main guild — leave false until Verification V2) ─
LEGACY_VERIFICATION_ENABLED="false"

# ── Minecraft server probing (SSRF surface — disabled by default) ─
MINECRAFT_SERVER_PROBE_ENABLED="false"

#  CODEX DEVS

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_URL="https://discord.com/api/webhooks/"
CMD_WEBHOOK_URL="https://discord.com/api/webhooks/"


# ── Cloudflare Tunnel For API Server ─────────────────────────────────────────────────────────
#
# How to get CF_TUNNEL_TOKEN (browser only, no CLI):
#   1. Go to https://one.dash.cloudflare.com
#   2. Networks → Tunnels → Create a tunnel → Choose "Cloudflared"
#   3. Give it a name (e.g. zyrox-api) and save
#   4. On the "Install connector" step, copy the token from the shown command:
#         cloudflared tunnel run --token <COPY_THIS_TOKEN>
#   5. Go to "Published Application Routes" tab → Add a Published Application Routes:
#         Subdomain: zyrox-api   Domain: yourdomain.com   Service: http://localhost:8000
#   6. Paste the token below — that's it. Permanent URL, unlimited traffic.
#
# Leave false unless this deployment explicitly needs a Cloudflare tunnel.
# If TUNNEL_ENABLED is absent, the tunnel stays disabled.
TUNNEL_ENABLED="false"
CF_TUNNEL_TOKEN="xxx_xxxx"
CF_TUNNEL_URL="https://zyrox-api.yourdomain.com"
