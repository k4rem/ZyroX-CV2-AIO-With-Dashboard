# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_generate_a_strong_secret

# Discord OAuth (identify scope only)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server-side bot API (never expose to browser)
BOT_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_KEY=
INTERNAL_IDENTITY_SIGNING_KEY=
INTERNAL_IDENTITY_AUDIENCE=cls-fastapi
INTERNAL_IDENTITY_TTL_SECONDS=60

# Root owner (server-side; must match bot ROOT_OWNER_ID)
ROOT_OWNER_ID=

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="ZyroX"
NEXT_PUBLIC_BRAND_NAME_WORD="ZX"
