# Phase 0: direct browser → bot FastAPI is disabled by default.
# Ignored in production (NODE_ENV=production) even if set true.
# Local dev only:
# NEXT_PUBLIC_LEGACY_DIRECT_BOT_API="true"
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_DASHBOARD_API_KEY=your_dev_only_key_matching_DASHBOARD_API_KEY

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# NextAuth Configuration
NEXTAUTH_URL=https://your-vercel-url-here-codex-devs.vercel.app/
NEXTAUTH_SECRET=change_me_generate_a_strong_secret

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="ZyroX"
NEXT_PUBLIC_BRAND_NAME_WORD="ZX"
